model PlanAuditLog {
  id String @id @default(cuid())

  // Admin display name/email.
  // Replace with User relation later if required.
  admin String

  action AuditAction

  plan   Plan   @relation(fields: [planId], references: [id])
  planId String

  // Human-readable snapshots.
  // Example:
  // previous = "£897/mo"
  // next     = "£997/mo"
  previous String
  next     String

  // What was affected.
  // Examples:
  // "New sign-ups only"
  // "12 subscribers"
  // "ABC Clinic"
  affected String

  // Optional structured information.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([planId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log_entries")
}
