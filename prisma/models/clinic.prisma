enum ClinicStatus {
    ACTIVE
    PENDING
    INACTIVE
    SUSPENDED
    DELETED
}

enum ClinicAdminStatus {
    ACTIVE
    PENDING
    INACTIVE
    SUSPENDED
    DELETED
}

model Clinic {
    id             String  @id @default(cuid())
    name           String?
    tradingCompany String?
    city           String?

    // Billing details
    billingName        String?
    billingEmail       String?
    vatNumber          String?
    stripeCustomerId   String?

    // google ads credentials 
    googleId           String?
    googleEmail        String?
    refreshToken       String?
    selectedCustomerId String?

    status    ClinicStatus @default(PENDING)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    admin         ClinicAdmin?
    postcodes     ClinicPostcode[]
    location      ClinicLocation?
    subscription  ClinicSubscription?
    overrides     ClinicOverride[]
    invoices      Invoice[]
    salesRequests PlanSalesRequest[]
    legalAcceptances ClinicLegalAcceptance[]

    // New relations for nurture
    nurtureSequences NurtureSequence[]
    campaigns        Campaign[]
}

model ClinicAdmin {
    id             String  @id @default(cuid())
    name           String?
    phone          String?
    profilePic     String?
    email          String  @unique
    password       String
    onTimePassword Boolean @default(false)
    clinicId       String  @unique
    clinic         Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

    isMainAdmin Boolean @default(false)
    isVerified  Boolean @default(false)

    status ClinicAdminStatus @default(PENDING)

    legalAcceptances ClinicLegalAcceptance[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ClinicPostcode {
    id          String   @id @default(cuid())
    code        String
    unavailable Boolean  @default(false)
    override    Boolean  @default(false)
    clinicId    String
    clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([clinicId, code])
}

model ClinicLocation {
    id        String   @id @default(cuid())
    lat       String?
    lng       String?
    clinicId  String   @unique
    clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ClinicSubscription {
    id          String     @id @default(cuid())
    plan        String // Solo, Growth, Pro, Enterprise
    locations   Int        @default(1)
    discount    String     @default("none")
    promoCode   String?
    monthlyFee  Float?
    setupFee    Float?
    status      String     @default("pending") // pending, active, cancelled, expired, grace, failed
    clinicId    String     @unique
    clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    planPrice   PlanPrice? @relation(fields: [planPriceId], references: [id])
    planPriceId String?

    stripeSubscriptionId  String?
    currentPeriodEnd      DateTime?
    cancelAtPeriodEnd     Boolean   @default(false)
    paymentMethodBrand    String?   @default("VISA")
    paymentMethodLast4    String?   @default("4242")
    paymentMethodExpMonth String?   @default("08")
    paymentMethodExpYear  String?   @default("27")
}

model Invoice {
    id            String   @id @default(cuid())
    invoiceNumber String   @unique
    clinicId      String
    clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
    amount        Float
    currency      String   @default("GBP")
    status        String   @default("Paid") // Paid, Pending, Failed
    pdfUrl        String?
    paymentDate   DateTime @default(now())
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([clinicId])
    @@map("invoices")
}

model PlanSalesRequest {
    id           String   @id @default(cuid())
    clinicId     String
    clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
    plan         PlanType @default(ENTERPRISE)
    locations    Int      @default(2)
    contactName  String?
    contactEmail String?
    notes        String?
    status       String   @default("pending") // pending, contacted, closed
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([clinicId])
    @@map("plan_sales_requests")
}
